{
	"name": "react-leaflet-deflate",
	"version": "3.2.0",
	"description": "React wrapper of Leaflet.Deflate. Substitues polygons and lines with markers when screen size falls below a defined threshold.",
	"main": "dist/react-leaflet-deflate.min.js",
	"module": "lib/index.js",
	"scripts": {
		"build": "npm run build:lib && npm run build:dist && npm run build:dev",
		"build:dist": "webpack",
		"build:dev": "webpack --mode development --output-path ./dist --output-filename react-leaflet-deflate.js",
		"build:lib": "npm run compile:lib",
		"clean:lib": "rm -Rf ./lib",
		"compile:lib": "babel ./src --out-dir lib",
		"prepublishOnly": "npm run build",
		"test": "jest",
		"test:unit": "jest",
		"test:e2e": "playwright test",
		"test:e2e:build": "webpack --config webpack.e2e.config.js",
		"debug:example": "node tests/e2e/server.js",
		"test:all": "npm run test:unit && npm run test:e2e"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mhasbie/react-leaflet-deflate.git"
	},
	"homepage": "https://mhasbie.github.io/react-leaflet-deflate/",
	"keywords": [
		"react",
		"leaflet",
		"react-leaflet",
		"deflate",
		"leaflet-deflate",
		"react-leaflet-deflate",
		"react-leaflet-v4",
		"react-leaflet-v5"
	],
	"author": "M. Hasbie",
	"license": "MIT",
	"peerDependencies": {
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"react": "^18.0.0 || ^19.0.0",
		"react-leaflet": "^4.0.0 || ^5.0.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.3",
		"@babel/core": "^7.28.5",
		"@babel/plugin-transform-class-properties": "^7.27.1",
		"@babel/plugin-transform-modules-commonjs": "^7.27.1",
		"@babel/preset-env": "^7.28.5",
		"@babel/preset-react": "^7.28.5",
		"@playwright/test": "^1.56.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"babel-jest": "^29.7.0",
		"babel-loader": "^10.0.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-leaflet": "^5.0.0",
		"webpack": "^5.102.1",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"Leaflet.Deflate": "^2.1.0"
	},
	"jest": {
		"collectCoverage": true,
		"testEnvironment": "jsdom",
		"transform": {
			"^.+\\.[jt]sx?$": "babel-jest"
		},
		"testMatch": [
			"**/__tests__/**/?(*.)+(spec|test).[jt]s?(x)"
		],
		"transformIgnorePatterns": [
			"/node_modules/(?!react-leaflet|@react-leaflet|leaflet|Leaflet.Deflate)/"
		]
	}
}
